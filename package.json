{
  "name": "deepseek-dovetail",
  "version": "0.1.0",
  "description": "Private DSH compatibility bundle for the eight OpenCnid Dovetail skills",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "dist/skills/**/*",
    "README.md",
    "COMPATIBILITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "materialize": "node scripts/materialize-skills.mjs",
    "build": "pnpm run materialize && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests scripts --deny-warnings",
    "test": "vitest run",
    "verify:resources": "node scripts/verify-resource-closure.mjs",
    "verify:port": "node scripts/verify-port.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run materialize && pnpm run verify:resources && pnpm run verify:port && pnpm run verify:package && vitest run tests/integration",
    "pack:artifact": "pnpm pack --pack-destination artifacts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "oxlint": "1.76.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
